<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ 알림 권한. 미디어 알림은 예외지만, 앱 정보에 "알림 차단됨"으로 남지 않게 요청한다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 재생을 멈추고 한동안 방치하면 시스템이 앱을 낮은 standby bucket으로 강등시켜,
         Android Auto가 백그라운드에서 MediaLibraryService를 다시 바인딩하지 못하고
         차량 미디어 소스 목록에서 사라지는 문제가 있었다. 배터리 최적화 제외를 요청해
         이 강등을 막기 위해 필요한 권한. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 케이블 없이 앱 내에서 새 버전을 내려받아 설치할 수 있도록 (GitHub Releases 기반 업데이트) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ARMSAndroidAuto">

        <!-- Android Auto/Automotive에 미디어 앱으로 등록 -->
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ARMSAndroidAuto">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ARMSMediaLibraryService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="android.car.intent.action.MEDIA_TEMPLATE" />
                <action android:name="androidx.car.app.mediaextensions.action.MEDIA_TEMPLATE_V2" />
            </intent-filter>
            <!-- AAOS Media Center가 이 앱을 미디어 소스로 인식하려면 필요 (com.android.car.media의
                 MediaSource.isMediaTemplate()이 확인하는 opt-in 플래그) -->
            <meta-data android:name="androidx.car.app.launchable" android:value="true" />
        </service>

        <!-- Now Playing 아트워크를 카미디어(다른 프로세스) UI에 content:// URI로 노출하기 위함 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.artworkprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 앱 프로세스가 죽어 있을 때(시동을 껐다 켠 뒤 등) 블루투스 헤드유닛의 PLAY 같은 미디어
             버튼을 받아 서비스를 깨우기 위해 필요하다. Media3가 이 리시버로 세션을 되살리고
             onPlaybackResumption()을 호출해 마지막에 듣던 것을 재개한다. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
